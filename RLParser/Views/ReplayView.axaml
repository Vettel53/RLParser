<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:RLParser.Models"
             xmlns:vm="using:RLParser.ViewModels"
             xmlns:views="using:RLParser.Views"
             xmlns:converters="using:RLParser.Converters"
             xmlns:designVm="using:RLParser.ViewModels.Design"
             mc:Ignorable="d" d:DesignWidth="1040" d:DesignHeight="720"
             x:Class="RLParser.Views.ReplaysView"
             x:DataType="vm:ReplaysViewModel">

  <UserControl.Resources>
    <converters:BitmapValueConverter x:Key="BitmapValueConverter" />
  </UserControl.Resources>

  <Design.DataContext>
    <designVm:DesignReplaysViewModel />
  </Design.DataContext>

  <Grid>
    <ScrollViewer IsVisible="{Binding !IsShowingReplayDetails}"
                  Margin="20,10,20,20"
                  Padding="0,20,0,20"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="20">
        <TextBlock Text="Recent Replays" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0"/>

        <ListBox ItemsSource="{Binding RecentReplays}"
                 SelectedItem="{Binding SelectedReplay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="280" ItemHeight="220" Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ReplayCardItem">
              <Border Classes="Card" MinWidth="240" MaxWidth="360" MinHeight="200" Margin="0,0,16,16">
                <Grid>
                  <Image Source="{Binding ThumbnailUri, Converter={StaticResource BitmapValueConverter}}" Stretch="UniformToFill" Opacity="0.55"/>
                  <Border Background="Black" Opacity="0.35"/>

                  <StackPanel VerticalAlignment="Bottom" Margin="20" Spacing="8">
                    <Border Background="#3f3f46" CornerRadius="4" HorizontalAlignment="Left" Padding="6,2">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding MatchType}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="-" Foreground="#a1a1aa" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding TeamSize, StringFormat={}{0}v{0}}" Foreground="White" FontWeight="Bold" FontSize="10"/>
                      </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding ReplayName}" FontSize="24" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="RESULT" Foreground="#4ade80" FontWeight="Bold" FontSize="14"/>
                      <TextBlock Text="|" Foreground="#a1a1aa"/>
                      <TextBlock Text="{Binding Team0Score}" Foreground="#d4d4d8" FontSize="14"/>
                      <TextBlock Text="-" Foreground="#d4d4d8" FontSize="14"/>
                      <TextBlock Text="{Binding Team1Score}" Foreground="#d4d4d8" FontSize="14"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Map}" FontSize="12" Foreground="#d4d4d8" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PlayerCount, StringFormat={}{0} players}" FontSize="12" Foreground="#d4d4d8"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </ScrollViewer>

    <views:ReplayDetailsView IsVisible="{Binding IsShowingReplayDetails}"
                             DataContext="{Binding}"/>
  </Grid>
</UserControl>
