<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="using:RLParser.Models"
             xmlns:vm="using:RLParser.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1040"
             d:DesignHeight="720"
             x:Class="RLParser.Views.ReplayDetailsView"
             x:DataType="vm:ReplaysViewModel">

  <ScrollViewer Margin="28" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="24">
      <Button Content="← Back to replays"
              Command="{Binding CloseReplayDetailsCommand}"
              HorizontalAlignment="Left"
              Background="Transparent"
              Foreground="#a1a1aa"
              Padding="0,8"/>

      <StackPanel DataContext="{Binding SelectedReplay}" Spacing="24">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding ReplayName}" FontSize="32" FontWeight="Bold" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding Context.Map}" FontSize="16" Foreground="#a1a1aa"/>
        </StackPanel>

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="14">
          <Border Grid.Column="0" Background="#18181b" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="PLAYLIST" Foreground="#71717a" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="{Binding Context.MatchType}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Background="#18181b" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="TEAM SIZE" Foreground="#71717a" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="{Binding Context.TeamSize, StringFormat={}{0}v{0}}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="#18181b" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="PLAYERS" Foreground="#71717a" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="{Binding PlayerCount}" FontSize="20" FontWeight="Bold"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="3" Background="#18181b" CornerRadius="10" Padding="16">
            <StackPanel Spacing="4">
              <TextBlock Text="GAME STATE" Foreground="#71717a" FontSize="11" FontWeight="Bold"/>
              <TextBlock Text="{Binding Context.CurrentGameState}" FontSize="16" FontWeight="SemiBold"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Background="#18181b" CornerRadius="12" Padding="24">
          <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="28">
            <StackPanel Grid.Column="0" HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="BLUE" Foreground="#60a5fa" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Context.Team0Score}" FontSize="48" FontWeight="Bold"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="FINAL" Foreground="#71717a" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center" Spacing="8">
              <TextBlock Text="ORANGE" Foreground="#fb923c" FontWeight="Bold" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding Context.Team1Score}" FontSize="48" FontWeight="Bold"/>
            </StackPanel>
          </Grid>
        </Border>

        <StackPanel Spacing="12">
          <TextBlock Text="Player Stats" FontSize="20" FontWeight="SemiBold"/>
          <ItemsControl ItemsSource="{Binding Context.ExtractedPlayers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PlayerData">
                <Border Background="#18181b" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                  <Grid ColumnDefinitions="2*,*,*,*,*,*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="3">
                      <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Team, StringFormat=Team {0}}" Foreground="#71717a" FontSize="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="Score" Foreground="#71717a" FontSize="11"/>
                      <TextBlock Text="{Binding Score}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Goals" Foreground="#71717a" FontSize="11"/>
                      <TextBlock Text="{Binding Goals}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                      <TextBlock Text="Boost grabs" Foreground="#71717a" FontSize="11"/>
                      <TextBlock Text="{Binding TotalBoostGrabs}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                      <TextBlock Text="Big pads" Foreground="#71717a" FontSize="11"/>
                      <TextBlock Text="{Binding BigBoostGrabs}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="5">
                      <TextBlock Text="Small pads" Foreground="#71717a" FontSize="11"/>
                      <TextBlock Text="{Binding SmallBoostGrabs}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                      <TextBlock Text="Steals" Foreground="#71717a" FontSize="11"/>
                      <TextBlock Text="{Binding BoostSteals}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
